# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# SUPABASE POSTGRESQL CONFIGURATION
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"
SUPABASE_ANON_KEY="your-supabase-anon-key"

# DATABASE: PostgreSQL direct connection string (optional alternative)
DATABASE_URL="postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres"

# AUTH: JWT secret for session signing
AUTH_SECRET="skillnest-jwt-secret-secure-key"

# BANGLADESH PAYMENT GATEWAYS
BKASH_APP_KEY=""
BKASH_APP_SECRET=""
BKASH_USERNAME=""
BKASH_PASSWORD=""

NAGAD_MERCHANT_ID=""
NAGAD_PUBLIC_KEY=""
NAGAD_PRIVATE_KEY=""

SSLCOMMERZ_STORE_ID=""
SSLCOMMERZ_STORE_PASSWORD=""
SSLCOMMERZ_IS_SANDBOX="true"

# OBJECT STORAGE (Cloudflare R2 / AWS S3 / Cloudinary)
STORAGE_PROVIDER="mock"
STORAGE_BUCKET="skillnest-assets"
STORAGE_ACCESS_KEY_ID=""
STORAGE_SECRET_ACCESS_KEY=""
STORAGE_ENDPOINT=""
